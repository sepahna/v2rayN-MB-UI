<reactiveui:ReactiveUserControl
    x:Class="v2rayN.Views.HomeLineView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:v2rayN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="96"
    d:DesignWidth="800"
    x:TypeArguments="vms:StatusBarViewModel"
    mc:Ignorable="d">
    <Border
        Margin="12,8,12,4"
        Padding="12,8"
        BorderBrush="{DynamicResource MaterialDesignDivider}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <base:FlagTextBlock
                        x:Name="txtFlag"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        FontSize="18" />
                    <TextBlock
                        x:Name="txtGlobe"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        FontSize="18"
                        Text="🌐" />
                    <TextBlock
                        x:Name="txtLabel"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock
                    x:Name="txtIp"
                    Margin="0,2,0,0"
                    Cursor="Hand"
                    FontSize="16"
                    FontWeight="Medium" />
                <DockPanel Margin="0,6,0,0">
                    <TextBlock
                        x:Name="txtDownload"
                        Margin="0,0,16,0"
                        DockPanel.Dock="Left"
                        FontSize="13" />
                    <TextBlock
                        x:Name="txtUpload"
                        Margin="0,0,16,0"
                        DockPanel.Dock="Left"
                        FontSize="13" />
                    <TextBlock
                        x:Name="txtTraffic"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Opacity="0.75" />
                </DockPanel>
                <Canvas
                    x:Name="wave"
                    Height="28"
                    Margin="0,4,0,0" />
            </StackPanel>
            <Button
                x:Name="btnPower"
                Grid.Column="1"
                Width="52"
                Height="52"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                ToolTip="VPN">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="26">
                            <materialDesign:PackIcon
                                Width="26"
                                Height="26"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="Power" />
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Border>
</reactiveui:ReactiveUserControl>
